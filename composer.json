{
    "name": "dezodev/filament-blok-field",
    "description": "Blok block editor (https://blokeditor.com) as a Filament v5 form field, with custom nested blocks declared via config",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "blok",
        "editor",
        "blocks"
    ],
    "authors": [
        {
            "name": "Dezodev"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Dezodev\\FilamentBlokField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dezodev\\FilamentBlokField\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dezodev\\FilamentBlokField\\FilamentBlokFieldServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    }
}
